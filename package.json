{
	"name": "n8n-nodes-opensolar",
	"version": "0.1.0",
	"description": "n8n community node for OpenSolar",
	"license": "MIT",
	"homepage": "https://github.com/chrisburke5845/n8n-nodes-opensolar#readme",
	"keywords": [
		"n8n-community-node-package"
	],
	"author": {
		"name": "Chris Burke",
		"email": "chrisburke5845@gmail.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/chrisburke5845/n8n-nodes-opensolar.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/OpenSolarApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/OpenSolar/OpenSolar.node.js",
			"dist/nodes/OpenSolarTrigger/OpenSolarTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.29.0",
		"n8n-workflow": "^2.34.1",
		"prettier": "3.9.6",
		"release-it": "20.2.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
